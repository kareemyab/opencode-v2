{
  // id-orgn app-gate Worker — used for BOTH local dev (`wrangler dev`) and the prod deploy
  // (GH Actions `wrangler deploy` on push to orgn). Production (SST infra/app.ts for the
  // upstream opencode.ai) does not read this file.
  //
  // Non-secret config lives in `vars` (committed). SECRETS (ID_ORGN_CLIENT_SECRET,
  // SESSION_SECRET) are NOT here — they're Cloudflare secrets set by the workflow from GH
  // secrets. For local dev, packages/function/.dev.vars overrides `vars` and supplies the
  // secrets (gitignored).
  "name": "opencode-app-gate",
  "main": "src/app-gate.ts",
  "compatibility_date": "2025-06-01",
  "routes": [{ "pattern": "cde.orgn.com", "custom_domain": true }],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_URL": "https://cde.orgn.com",
    "ID_ORGN_URL": "https://id.orgn.com",
    "ID_ORGN_CLIENT_ID": "vU3lIIaieXkg4dzpd6GVee76CsDNHFRD",
    "OPENCODE_CHANNEL": "prod",
    // Static fallback backend the Worker proxies /__api to. Empty = the data plane resolves a
    // per-request Daytona sandbox from the X-OpenCode-Target-URL header (SSRF-allowlisted to
    // *.proxy.daytona.orgn.com).
    "OPENCODE_BACKEND_URL": "",
    // Daytona API for minting per-sandbox preview tokens (private previews). The matching
    // DAYTONA_API_KEY is a Cloudflare secret (set via the workflow / wrangler secret put).
    "DAYTONA_API_URL": "https://daytona.orgn.com"
  }
}
